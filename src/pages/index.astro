---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Nav from '../components/Nav.astro';
import BuildSequence from '../components/BuildSequence.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Manifesto from '../components/Manifesto.astro';
import Interior from '../components/Interior.astro';
import Services from '../components/Services.astro';
import Blueprint from '../components/Blueprint.astro';
import Visita from '../components/Visita.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Intro />
  <Nav />
  <main id="conteudo">
    <BuildSequence />
    <BeforeAfter />
    <Manifesto />
    <Interior />
    <Services />
    <Blueprint />
    <Visita />
    <Contact />
  </main>
  <Footer />
</Base>
