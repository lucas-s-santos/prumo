---
import Bob from './Bob.astro';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`inline-flex items-center gap-2 ${cls}`}>
  <span class="flex flex-col items-center" aria-hidden="true">
    <span class="block h-[7px] w-px bg-current opacity-80"></span>
    <Bob size={11} />
  </span>
  <span class="text-[0.8rem] font-normal tracking-[0.42em]">PRUMO</span>
</span>
