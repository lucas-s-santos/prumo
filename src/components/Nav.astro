---
import Logo from './Logo.astro';
import Bob from './Bob.astro';
import { image } from '../lib/assets';
import { CONTATO, waLink, igLink, mailLink } from '../lib/contato';
// Itens do menu: rótulo, âncora e a foto que entra ao fundo, em ripado, no hover (scripts/nav.ts).
// As teclas 1–8 levam às seções nesta ordem.
const itens = [
  ['A obra', '#obra', image('03-estrutura')],
  ['Antes & depois', '#comparar', image('05-pronta')],
  ['O escritório', '#manifesto', image('detalhe')],
  ['Por dentro', '#casa', image('interior')],
  ['Serviços', '#servicos', image('servico-projeto')],
  ['Projeto', '#planta', image('projeto-traco')],
  ['Visita', '#visita', image('galeria-07')],
  ['Contato', '#contato', image('contato-noite')],
] as const;
// Letra por letra, para o hover "rolar" cada uma com um pequeno atraso (global.css, .roll).
const letters = (t: string) => [...t].map((c) => (c === ' ' ? ' ' : c));
// Tiras do ripado (a foto nova entra tira por tira, como o ripado de cedro da fachada).
const RIPAS = 9;
---
<header class="fixed inset-x-0 top-4 z-50 flex justify-center px-4">
  <nav
    class="nav-pill flex items-center gap-1 rounded-full border border-white/10 bg-ink/60 py-1.5 pr-1.5 pl-4 text-white backdrop-blur-xl"
    aria-label="Principal"
  >
    <a href="#topo" class="mr-1" aria-label="PRUMO, início"><Logo /></a>
    <!-- Seção atual -->
    <span class="nav-now ml-3 hidden h-[1.2em] w-[9.5rem] overflow-hidden border-l border-white/15 pl-3 text-[0.8rem] leading-[1.2] text-white/60 md:block" aria-hidden="true">
      <span class="nav-now-t block">A obra</span>
    </span>
    <button
      type="button"
      class="nav-toggle ml-2 flex items-center gap-2.5 rounded-full px-3 py-2 text-[0.8rem] text-white/85 transition hover:text-white"
      aria-expanded="false"
      aria-controls="menu"
      aria-keyshortcuts="M"
    >
      <span class="nav-burger relative block h-2.5 w-4" aria-hidden="true">
        <span class="absolute inset-x-0 top-0 h-px bg-current transition duration-500"></span>
        <span class="absolute inset-x-0 bottom-0 h-px bg-current transition duration-500"></span>
      </span>
      <span class="nav-label block h-[1.2em] overflow-hidden leading-[1.2]">
        <span class="block transition-transform duration-500">Menu</span>
        <span class="block transition-transform duration-500">Fechar</span>
      </span>
    </button>
    <a
      href="#contato"
      class="ml-1 hidden rounded-full bg-amber px-4 py-2 text-[0.8rem] font-medium text-ink transition hover:bg-[#f0b574] sm:inline-block"
    >Iniciar projeto</a>
  </nav>
</header>

<!-- Fio que cai do botão: o menu abre para os lados a partir dele -->
<span class="menu-line pointer-events-none fixed top-0 z-[45] h-svh w-px origin-top scale-y-0 bg-amber shadow-[0_0_18px_2px_rgba(232,163,92,.85)]" aria-hidden="true"></span>

<div id="menu" class="menu fixed inset-0 z-40 overflow-hidden bg-ink text-white" hidden>
  <div class="absolute inset-0" aria-hidden="true">
    <img class="menu-base absolute inset-0 h-full w-full object-cover" alt="" decoding="async" />
    <div class="menu-ripas absolute inset-0">
      {Array.from({ length: RIPAS }, (_, i) => (
        <div class="menu-ripa absolute inset-y-0 overflow-hidden" style={`left:${(i * 100) / RIPAS}%;width:${100 / RIPAS}%`}>
          <img class="absolute inset-y-0 h-full max-w-none object-cover" style={`left:${-i * 100}%;width:${RIPAS * 100}%`} alt="" decoding="async" />
        </div>
      ))}
    </div>
    <div class="absolute inset-0 bg-linear-to-r from-ink/90 via-ink/70 to-ink/30"></div>
  </div>

  <div class="menu-body container-x relative flex h-full flex-col justify-end overflow-y-auto pt-24 pb-6 md:justify-center md:pb-0">
    <ol class="menu-list">
      {itens.map(([t, href, src], i) => (
        <li class="overflow-hidden">
          <a href={href} data-img={src} class="menu-link flex items-baseline gap-4 py-[0.2em] transition-opacity duration-300 md:gap-7" aria-keyshortcuts={String(i + 1)}>
            <span class="menu-n w-6 shrink-0 text-xs text-white/55 tabular-nums transition-colors">0{i + 1}</span>
            <span class="relative inline-block">
              <span class="roll text-[clamp(1.8rem,min(6vw,6.6svh),5rem)] font-medium tracking-[-0.035em]">
                {letters(t).map((c, k) => <span style={`--i:${k}`}>{c}</span>)}
              </span>
              <!-- Quanto desta seção você já viu -->
              <span class="menu-prog absolute inset-x-0 -bottom-0.5 block h-px bg-white/12"><span class="menu-prog-fill block h-full origin-left scale-x-0 bg-amber/80"></span></span>
            </span>
            <span class="menu-here hidden self-center text-[0.65rem] tracking-[0.2em] text-amber uppercase md:inline">Você está aqui</span>
          </a>
        </li>
      ))}
    </ol>

    <div class="menu-foot mt-8 grid gap-4 border-t border-white/15 pt-5 text-sm text-white/60 md:mt-10 md:grid-cols-[1fr_auto_auto] md:items-end md:gap-10">
      <div class="flex flex-wrap gap-x-6 gap-y-1">
        <a href={waLink('Olá! Vim pelo site da PRUMO.')} target="_blank" rel="noopener" class="transition hover:text-white">WhatsApp {CONTATO.telefone}</a>
        <a href={mailLink} class="transition hover:text-white">{CONTATO.email}</a>
        <a href={igLink} target="_blank" rel="noopener" class="transition hover:text-white">@{CONTATO.instagram}</a>
      </div>
      <p>
        Alfenas · <span class="menu-clock text-white tabular-nums">--:--</span>
        <span class="ml-3 hidden text-white/50 lg:inline">Atalhos: <kbd class="font-sans">M</kbd> menu · <kbd class="font-sans">1–8</kbd> seções</span>
      </p>
      <a href="#contato" class="justify-self-start rounded-full bg-amber px-6 py-3 font-medium text-ink transition hover:bg-[#f0b574] md:justify-self-end">Iniciar projeto</a>
    </div>
  </div>
</div>

<!-- Fio de prumo: substitui a barra de rolagem. Marcas de nível em cada seção (clicáveis no desktop). -->
<div class="plumb fixed top-1/2 right-0 z-30 h-[46svh] w-4 -translate-y-1/2 md:right-4 md:w-6" aria-hidden="true">
  <span class="absolute inset-y-0 left-1/2 w-px bg-white/20 mix-blend-difference"></span>
  <span class="plumb-line absolute inset-x-0 top-0 mx-auto h-full w-px origin-top scale-y-0 bg-white/80 mix-blend-difference"></span>
  <span class="plumb-ticks absolute inset-0"></span>
  <span class="plumb-bob absolute top-0 left-1/2 -ml-[5px] block"><Bob size={10} /></span>
</div>
