---
import { image } from '../lib/assets';
// A casa à noite ao fundo (assenta com o scroll em scripts/contact.ts); texto e formulário no céu escuro à esquerda.
const bg = image('contato-noite') ?? image('05-pronta');
const tipos = ['Casa nova', 'Reforma', 'Interiores'];
---
<section id="contato" data-nav="Contato" class="relative isolate overflow-hidden bg-ink text-white">
  {bg && <img src={bg} alt="" class="ct-bg absolute inset-0 -z-10 h-full w-full object-cover object-[72%_50%]" loading="lazy" decoding="async" />}
  <div class="absolute inset-0 -z-10 bg-linear-to-r from-ink/90 via-ink/60 to-ink/0"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-1/3 bg-linear-to-t from-ink/70 to-transparent"></div>

  <div class="container-x grid min-h-svh items-center py-28 md:grid-cols-12">
    <div class="md:col-span-6 lg:col-span-5">
      <p class="eyebrow text-white/55" data-reveal>Seu próximo projeto</p>
      <h2 class="mt-5 text-[clamp(2.2rem,4.6vw,3.8rem)] leading-[1] font-medium tracking-[-0.03em]" data-reveal>
        Vamos começar pela <span class="accent text-amber">sua ideia.</span>
      </h2>
      <p class="mt-5 max-w-[40ch] text-white/70" data-reveal>
        Conte o básico. Em até dois dias úteis um arquiteto da equipe retorna para marcar uma visita ao terreno.
      </p>

      <form class="contact mt-10 grid gap-5 rounded-[10px] border border-white/10 bg-ink/45 p-6 backdrop-blur-xl md:p-8" data-reveal novalidate>
        <fieldset>
          <legend class="eyebrow mb-3 text-white/55">Tipo de projeto</legend>
          <div class="flex flex-wrap gap-2">
            {tipos.map((t, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="tipo" value={t} class="peer sr-only" checked={i === 0} />
                <span class="block rounded-full border border-white/20 px-4 py-2 text-sm text-white/80 transition peer-checked:border-paper peer-checked:bg-paper peer-checked:text-ink peer-focus-visible:ring-2 peer-focus-visible:ring-amber">{t}</span>
              </label>
            ))}
          </div>
        </fieldset>
        {[
          ['nome', 'Seu nome', 'text', 'name'],
          ['contato', 'E-mail ou WhatsApp', 'text', 'email'],
          ['cidade', 'Cidade do terreno', 'text', 'address-level2'],
        ].map(([id, label, type, ac]) => (
          <label class="block">
            <span class="text-sm text-white/60">{label}</span>
            <input id={`f-${id}`} name={id} type={type} autocomplete={ac} required={id !== 'cidade'} class="mt-1 w-full border-b border-white/20 bg-transparent py-2.5 text-lg text-white outline-none transition focus:border-amber" />
          </label>
        ))}
        <label class="block">
          <span class="text-sm text-white/60">Conte um pouco da casa que você imagina</span>
          <textarea name="mensagem" rows="2" class="mt-1 w-full resize-none border-b border-white/20 bg-transparent py-2.5 text-lg text-white outline-none transition focus:border-amber"></textarea>
        </label>
        <div class="mt-2 flex flex-wrap items-center justify-between gap-4">
          <p class="contact-msg text-sm text-white/60" aria-live="polite"></p>
          <button class="rounded-full bg-amber px-6 py-3.5 text-sm font-medium text-ink transition hover:bg-[#f0b574]">Enviar briefing</button>
        </div>
      </form>

      <div class="mt-8 flex flex-wrap gap-x-6 gap-y-1 text-sm text-white/60" data-reveal>
        <p>contato@prumo.arq.br</p>
        <p>(35) 9 0000-0000</p>
        <p>Alfenas · Sul de Minas</p>
      </div>
    </div>
  </div>
</section>
